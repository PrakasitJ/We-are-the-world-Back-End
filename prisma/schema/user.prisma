model User {
  uuid              String   @id @default(uuid()) @db.Uuid
  username          String   @unique @db.VarChar(30)
  email             String   @unique @db.VarChar(20)
  password          String
  name              String   @db.VarChar(15)
  surname           String   @db.VarChar(15)
  tel               String   @db.VarChar(10)
  salt              String   @db.VarChar(10)
  current_location  Int?     @unique
  profile_image_url String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  Admin   Admin?
  Charity Charity?
  Shop    Shop[]
  Rider   Rider?
  Order   Order[]

  User_locations  User_location[] @relation("UserToLocations")
  currentLocation User_location?  @relation("UserToCurrentLocation", fields: [current_location], references: [id])
}
