model Report {
    id                  Int      @id @default(autoincrement())
    checked_by_admin_id Int?
    reason_id           Int      @unique
    report_by           Who
    report_to           Who
    from_order_id       Int
    note                String
    status              status
    created_at          DateTime @default(now())
    updated_at          DateTime @updatedAt

    admin  Admin?  @relation(fields: [checked_by_admin_id], references: [id])
    order  Order   @relation(fields: [from_order_id], references: [id])
    reason Reason? @relation(fields: [reason_id], references: [id])
}

enum Who {
    USER
    CHARITY
    RIDER
    SHOP
}

enum status {
    PENDING
    RESOLVED
    REJECTED
}
