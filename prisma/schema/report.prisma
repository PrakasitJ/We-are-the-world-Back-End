model Report {
    id                  Int      @id @default(autoincrement())
    checked_by_admin_id Int?
    reported_by_user_id String   @db.Uuid
    report2_charity_id  Int?
    report2_shop_id     Int?
    report2_rider_id    Int?
    from_order_id       Int
    note                String
    status              String
    created_at          DateTime @default(now())
    updated_at          DateTime @updatedAt

    user    User     @relation(fields: [reported_by_user_id], references: [uuid])
    admin   Admin?   @relation(fields: [checked_by_admin_id], references: [id])
    charity Charity? @relation(fields: [report2_charity_id], references: [id])
    shop    Shop?    @relation(fields: [report2_shop_id], references: [id])
    rider   Rider?   @relation(fields: [report2_rider_id], references: [id])
    order   Order    @relation(fields: [from_order_id], references: [id])
}
